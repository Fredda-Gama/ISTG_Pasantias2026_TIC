# Copia este archivo como ".env" (sin el .example) y pon tus datos reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).

DB_HOST=localhost
DB_USER= el nombre de usuario de tu base de datos
DB_PASSWORD= la clave  para accesar a tu base de datos
DB_NAME=inventario_istg

# Clave secreta para las sesiones de Flask (usuario logueado).
# Cambia este valor por uno propio antes de desplegar a producción.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
